[
  {
    "id": "recommend_text",
    "description": "纯文本推荐：用户请求推荐商品",
    "request": {
      "message": "推荐一款洁面乳",
      "session_id": "eval_recommend_text"
    },
    "expected_events": ["token", "product_card", "done"],
    "forbidden_events": ["error", "guardrail"],
    "expected_in_answer": ["洁面", "推荐"]
  },
  {
    "id": "recommend_with_budget",
    "description": "带预算推荐：用户指定价格上限",
